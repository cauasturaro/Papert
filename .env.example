# make up automatically generates .env when the file does not exist.

# PostgreSQL admin password (used by Floci/RDS provisioning and the db tools profile)
POSTGRES_PASSWORD=

# Service-specific database users — isolated schemas, no cross-access
CORE_DB_PASSWORD=
SEYMOUR_DB_PASSWORD=

# Core API database URL (Prisma)
# Example: postgresql://core_user:<CORE_DB_PASSWORD>@localhost:7001/papert?schema=core
DATABASE_URL=

# Seymour API database URL (SQLAlchemy asyncpg)
# Example: postgresql+asyncpg://seymour_user:<SEYMOUR_DB_PASSWORD>@localhost:7001/papert
SEYMOUR_DATABASE_URL=

# Authentication — server-side only. Never prefix these with NEXT_PUBLIC_.
WEB_ORIGIN=http://localhost:3000
CORE_API_URL=http://localhost:3001
AUTH_JWE_ACTIVE_KID=local-v1
# JSON object: {"local-v1":"<openssl rand -hex 32>"}. Do not use the placeholder.
AUTH_JWE_KEYS=

# Phase 05 transport (server-side). Leave WEBSOCKET_URL empty for HTTP recovery only.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
CHAT_QUEUE_URL=http://localhost:4566/000000000000/papert-chat
RESULTS_QUEUE_URL=http://localhost:4566/000000000000/papert-results
SESSIONS_TABLE=papert-sessions
CORE_EXECUTION_CONTROL_FUNCTION=papert-core-local-executionControl
WEBSOCKET_URL=
WEBSOCKET_MANAGEMENT_URL=

# OpenAI inference. Server-side only; Langfuse remains self-hosted.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano-2026-03-17
# Local Langfuse keys are generated separately in .env.langfuse.
LANGFUSE_BASE_URL=http://localhost:3003
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Blank existing entries stop setup; restore credentials for existing volumes.
# Reference for the variables generated by make langfuse.
# Automatic setup creates .env.langfuse; no template copy is needed.
# For manual setup, fill every blank value before starting Compose.

# Independent backing services
LF_POSTGRES_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_REDIS_PASSWORD=
LF_STORAGE_PASSWORD=

# Application secrets. LF_ENCRYPTION_KEY requires 64 hexadecimal characters.
LF_SALT=
LF_ENCRYPTION_KEY=
LF_AUTH_SECRET=

# Local administrator login
LF_ADMIN_EMAIL=admin@papert.local
LF_ADMIN_PASSWORD=

# Project API keys shared by Langfuse initialization and the Seymour worker
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3003

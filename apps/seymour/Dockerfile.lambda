FROM public.ecr.aws/lambda/python:3.12@sha256:e101b645fd89a17abe636ea521eea44c6fffa4d59c0a61be5ca1d7d07c4be3e3
COPY apps/seymour/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken
RUN python -c "import tiktoken; tiktoken.encoding_for_model('text-embedding-3-small')"
COPY apps/seymour/src ${LAMBDA_TASK_ROOT}/src
COPY apps/seymour/main.py apps/seymour/mangum_handler.py apps/seymour/worker_handler.py ${LAMBDA_TASK_ROOT}/
# Lambda supplies its own runtime API, so the local emulator is dropped.
RUN rm -f /usr/local/bin/aws-lambda-rie
USER 10001:10001
CMD ["worker_handler.handler"]

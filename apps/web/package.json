{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "predev": "node scripts/prepare-monaco.mjs && node scripts/prepare-type-packs.mjs && node scripts/prepare-pdf.mjs",
    "prebuild": "node scripts/prepare-monaco.mjs && node scripts/prepare-type-packs.mjs && node scripts/prepare-pdf.mjs",
    "test": "npm run test:unit",
    "postinstall": "npm ci --prefix type-packs --ignore-scripts",
    "test:unit": "node --experimental-strip-types --test 'app/**/*.test.mjs' 'lib/**/*.test.mjs' 'components/**/*.test.mjs' scripts/prepare-type-packs.test.mjs",
    "test:type-packs": "node scripts/prepare-type-packs.mjs && node --test scripts/prepare-type-packs.smoke.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "^5.105.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "monaco-editor": "^0.57.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}

FROM public.ecr.aws/lambda/python:3.12@sha256:e101b645fd89a17abe636ea521eea44c6fffa4d59c0a61be5ca1d7d07c4be3e3
COPY apps/ingestion/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY apps/ingestion/src ${LAMBDA_TASK_ROOT}/src
# Lambda supplies its own runtime API, so the local emulator is dropped.
RUN rm -f /usr/local/bin/aws-lambda-rie
USER 10001:10001
CMD ["src.handler.handler"]

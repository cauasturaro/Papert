FROM public.ecr.aws/lambda/python:3.12@sha256:f229f304f82f5016fe26e4714d05b6a8196e0c6c61b463112841a5e3c3647163
# Applies the OS security fixes published after the base image was built.
RUN dnf upgrade -y --releasever=latest && dnf clean all
COPY apps/ingestion/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY apps/ingestion/src ${LAMBDA_TASK_ROOT}/src
# Lambda supplies its own runtime API, so the local emulator is dropped.
RUN rm -f /usr/local/bin/aws-lambda-rie
USER 10001:10001
CMD ["src.handler.handler"]
